{
    "name": "softlab180/laravel-bancard",
    "description": "Laravel package for Bancard VPOS 2.0 payment gateway integration (Paraguay)",
    "keywords": ["laravel", "bancard", "vpos", "payment", "paraguay", "gateway"],
    "license": "MIT",
    "authors": [
        {
            "name": "180 Softlab",
            "email": "dev@180softlab.com"
        }
    ],
    "version": "1.1.1",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Softlab180\\Bancard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softlab180\\Bancard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Softlab180\\Bancard\\BancardServiceProvider"
            ],
            "aliases": {
                "Bancard": "Softlab180\\Bancard\\Facades\\Bancard"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
